@using BlazorBlocks.Customization
@inherits BlockEditor<ImageBlockModel>

<h3>Image</h3>
<div class="bb-field">
	<label class="bb-field__label" for="imageHeight">Image height</label>
    <input type="number" id="imageHeight" @bind="Model.Height" @bind:after="OnValuesChanged" />
</div>
<div class="bb-field">
    <label class="bb-field__label" for="imageSrc">Image Url</label>
    <input type="text" id="imageSrc" @bind="Model.ImageUrl" @bind:after="OnValuesChanged" />
</div>
<div class="bb-field">
    <label class="bb-field__label" for="imageAlt">Image Alt</label>
    <input type="text" id="imageAlt" @bind="Model.AltText" @bind:after="OnValuesChanged" />
</div>
