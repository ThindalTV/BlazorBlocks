@inherits BlazorBlocks.Customization.BlockRenderer<ImageBlockModel>
@if (Model.ResolvedSource is not { } src)
{
    <text>No image</text>
}
else
{
    var hasAlt = !string.IsNullOrWhiteSpace(Model.AltText);
    <img src="@src" alt="@(Model.AltText ?? "")" aria-label="@(hasAlt ? Model.AltText : null)" aria-hidden="@(hasAlt ? "false" : "true")" height="@Model.Height" /><br />
}
