@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback OnClose { get; set; }

    /// <summary>Makes the dialog fill the window (minus a margin), for editors that need room.</summary>
    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public bool IsOpen
    {
        get;
        set
        {
            if (value == field)
            {
                return;
            }
            field = value;

            if (value)
            {
                InvokeAsync(ShowDialog);
            }
            else
            {
                InvokeAsync(CloseDialog);
            }


            IsOpenChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    [EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;

    private readonly Guid _diagId = Guid.NewGuid();

    private string DialogElementId => $"dialog{_diagId}";
    private string TitleElementId => $"dialog-title{_diagId}";

    private async Task ShowDialog()
    {
        var jsObj = await JSRuntime.InvokeAsync<IJSObjectReference>($"document.getElementById", DialogElementId);
        await jsObj.InvokeVoidAsync("showModal");
        await jsObj.DisposeAsync();
    }

    private async void CloseDialog()
    {
        var jsObj = await JSRuntime.InvokeAsync<IJSObjectReference>($"document.getElementById", DialogElementId);
        await jsObj.InvokeVoidAsync("close");
        await jsObj.DisposeAsync();
    }

    // Close button, backdrop click and Escape all end up here.
    private async Task RequestClose()
    {
        await OnClose.InvokeAsync();
        IsOpen = false;
    }

    // Raised by the browser when the dialog closes, including via Escape.
    private async Task OnNativeClose()
    {
        if (IsOpen)
        {
            await RequestClose();
        }
    }
}

<dialog id="@DialogElementId" class="bb-dialog@(Expanded ? " bb-dialog--expanded" : "")" aria-labelledby="@TitleElementId" @onclose="OnNativeClose" @onclick="RequestClose">
    @* Clicks inside the surface must not reach the dialog element, which treats them as backdrop clicks. *@
    <div class="bb-dialog__surface" @onclick:stopPropagation="true">
        <header class="bb-dialog__header">
            <h2 id="@TitleElementId" class="bb-dialog__title">@Title</h2>
            <button type="button" class="bb-dialog__close" aria-label="Close" @onclick="RequestClose">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>
        </header>
        <div class="bb-dialog__body">
            @ChildContent
        </div>
    </div>
</dialog>
