@using BlazorBlocks
@using BlazorBlocks.Internals
@using BlazorBlocks.Services
@using BlazorBlocks.Services.Registrations
<Dialog Title="Add new group" OnClose="HideDialog" @bind-IsOpen="Visible">
    <div class="bb-dialog-tiles">
        @foreach (var groupRegistration in BlockRegistrationService.Groups)
        {
            <button type="button" class="bb-dialog-tile" @onclick="() => ItemClicked(groupRegistration)">
                <div class="bb-dialog-tile__preview" aria-hidden="true">
                    @foreach (var row in GroupPreview.GetRows(groupRegistration))
                    {
                        <div class="bb-dialog-tile__preview-row">
                            @foreach (var span in row)
                            {
                                <span style="flex: @span"></span>
                            }
                        </div>
                    }
                </div>
                <span>@groupRegistration.Name</span>
            </button>
        }
    </div>
</Dialog>
@code {

    [Parameter, EditorRequired] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter, EditorRequired] public required int InsertIndex { get; set; }

    [Parameter, EditorRequired] public required EventCallback<NewGroupDialogResult> OnGroupSelected { get; set; }

    private async Task ItemClicked(GroupRegistration groupType)
    {
        await HideDialog();

        if (!OnGroupSelected.HasDelegate)
        {
            return;
        }
        await OnGroupSelected.InvokeAsync(new NewGroupDialogResult(groupType, InsertIndex));
    }

    private async Task HideDialog()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }
}
