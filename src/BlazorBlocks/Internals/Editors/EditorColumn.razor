@using BlazorBlocks
@using BlazorBlocks.Customization
@using BlazorBlocks.Internals
@using BlazorBlocks.Internals.Components;
@using BlazorBlocks.Internals.Containers
@using BlazorBlocks.Internals.Models
@using BlazorBlocks.Internals.Support
@using BlazorBlocks.Services
@using BlazorBlocks.Services.Registrations

@inject DragService DropService

@code {
    [Parameter, EditorRequired]
    public required BaseModel? ParentModel { get; set; }

    [Parameter, EditorRequired]
    public required EditorColumnModel Model { get; set; }

    [CascadingParameter]
    public required BlazorBlocksEditor Editor { get; set; }

    protected bool AddNewBlockDialogOpen { get; set; }

    // The block whose editor is currently shown in the expanded dialog instead of inline.
    private EditorBlockModel? _expandedBlock;
    private bool _expandedDialogOpen;

    private void ExpandBlock(BaseModel block)
    {
        if (block is EditorBlockModel model)
        {
            _expandedBlock = model;
            _expandedDialogOpen = true;
        }
    }

    private void CollapseExpandedBlock()
    {
        _expandedDialogOpen = false;
        _expandedBlock = null;
    }

    private async Task AddBlock(BlockRegistration blockType)
    {
        var blockModel = Activator.CreateInstance(blockType.BlockModel) as BaseBlockModel;
        if (blockModel == null) throw new InvalidOperationException($"Attempting to create a block model that is not a EditorBlockBaseModel. (It is {blockType.BlockModel.Name})");

        var blockEditorModel = new EditorBlockModel { Block = blockModel, ParentModel = Model };

        Model.AddBlock(blockEditorModel, _addingBlockIndex ?? 0);
        AddNewBlockDialogOpen = false;
        await Editor.OnModelUpdated.InvokeAsync();
    }

    private int? _addingBlockIndex;
    protected void AddBlockClicked(int index)
    {
        _addingBlockIndex = index;
        // Open dialog to add a new block
        OpenAddNewBlockDialog();
    }

    protected void OpenAddNewBlockDialog()
    {
        AddNewBlockDialogOpen = true;
    }

    protected async Task DeleteBlock(BaseModel block)
    {
        if (block is EditorBlockModel model)
        {
            Model.RemoveBlock(model);
            await Editor.OnModelUpdated.InvokeAsync();
        }
    }

    private bool _dragging;


    public void SetReadyToDrop()
    {
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        DropService.DraggedBlockChanged += (dragging) =>
        {
            _dragging = dragging;
            StateHasChanged();
        };
    }

    protected string ActiveDraggableClass => _dragging ? "dropZone active" : "dropZone";

    private async Task BlockDropped(ObjectDroppedResult dropped)
    {
        if (dropped.Model is not EditorBlockModel droppedBlock)
        {
            return;
        }

        if (dropped.ParentColumn is not EditorColumnModel previousColumn)
        {
            return;
        }

        // If we're dropping on the same column, we'll just reorder the blocks
        if (previousColumn.Id == Model.Id)
        {
            var oldIndex = Model.Blocks.IndexOf(droppedBlock);
            // If the group is being dropped on itself, do nothing
            if (oldIndex == dropped.Index)
            {
                return;
            }

            // If the group is being dropped on a different index, move it
            if (oldIndex < dropped.Index)
            {
                // We're moving down, insert at new index then remove the old one
                Model.Blocks.Insert(dropped.Index, droppedBlock);
                Model.Blocks.RemoveAt(oldIndex);
            }
            else
            {
                // We're moving up, remove the old one then insert at new index
                Model.Blocks.RemoveAt(oldIndex);
                Model.Blocks.Insert(dropped.Index, droppedBlock);
            }
        }
        else
        {
            droppedBlock.ParentModel = Model;
            // We're dropping on another column than where the block originated.
            previousColumn.Blocks.Remove(droppedBlock);
            Model.Blocks.Insert(dropped.Index, droppedBlock);
        }

        await Editor.OnModelUpdated.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

}

<Dialog @bind-IsOpen="AddNewBlockDialogOpen" Title="Add new block" OnClose="() => { AddNewBlockDialogOpen = false; }">
    <div class="bb-dialog-tiles">
        @foreach (var blockType in BlockRegistrationService.Blocks)
        {
            <button type="button" class="bb-dialog-tile" @onclick="() => AddBlock(blockType)">
                @if (!string.IsNullOrEmpty(blockType.Image))
                {
                    <img class="bb-dialog-tile__image" src="@blockType.Image" alt="" />
                }
                <span>@blockType.Name</span>
            </button>
        }
    </div>
</Dialog>

@* The dialog element is always rendered; only its content depends on the expanded block, so the editor exists once. *@
<Dialog @bind-IsOpen="_expandedDialogOpen" Expanded="true" Title="@(_expandedBlock?.Block.EditorName)" OnClose="CollapseExpandedBlock">
    @if (_expandedBlock is not null)
    {
        <BlockContainer Model="@_expandedBlock.Block" />
    }
</Dialog>

<div class="@Model.ColumnClass bb-editor__column">
    @for (var index = 0; index < Model.Blocks.Count; index++)
    {
        var block = Model.Blocks[index];

        <AddBlockRow ObjectType="DragObjectType.Block" OnDropped="BlockDropped" Index="@index" OnClicked="AddBlockClicked" />
        <DraggableContainer Model="@block"
                            ObjectType="DragObjectType.Block"
                            Title="@block.Block.EditorName"
                            Draggable="true" OnDelete="(model) => DeleteBlock(model)" OnExpand="ExpandBlock" ParentModel="@Model"
                            AdditionalCssClasses="bb-draggable--block">
            @if (block == _expandedBlock)
            {
                <p class="bb-block__expanded-note">Editing in expanded view</p>
            }
            else
            {
                <BlockContainer Model="@block.Block" />
            }
        </DraggableContainer>
    }
    <AddBlockRow ObjectType="DragObjectType.Block" OnDropped="BlockDropped" OnClicked="AddBlockClicked" Index="@Model.Blocks.Count" />
</div>

