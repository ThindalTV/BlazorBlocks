@using BlazorBlocks.Customization
@using Microsoft.JSInterop
@inherits BlockEditor<WysiwygBlockModel>
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WysiwygBlockOptions Options

<h3>Rich text</h3>
@if (_error is not null)
{
    <p class="bb-field__error" role="alert">@_error</p>
}
@* Blazor must never render children into this element: TinyMCE owns it once the module has created the editor. *@
<div @ref="_host" class="bb-wysiwyg-editor"></div>

@code {
    private ElementReference _host;
    private DotNetObjectReference<WysiwygBlockEditor>? _self;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private string? _error;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/BlazorBlocks.Blocks.Wysiwyg/tinymce-editor.js");

            // DisposeAsync may have run while the import was pending, when it had nothing to release yet.
            if (_disposed)
            {
                await DisposeModule(module);
                return;
            }

            _module = module;
            _self = DotNetObjectReference.Create(this);
            var editor = await _module.InvokeAsync<IJSObjectReference>("create", _host, _self, Model.Content,
                new { scriptUrl = Options.ScriptUrl, licenseKey = Options.LicenseKey, height = Options.Height });

            if (_disposed)
            {
                await DisposeEditor(editor);
                return;
            }

            _editor = editor;
        }
        catch (JSException e)
        {
            _error = e.Message;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnContentChanged(string html)
    {
        if (html == Model.Content)
        {
            return;
        }

        Model.Content = html;
        await OnValuesChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _self?.Dispose();

        if (_editor is not null)
        {
            await DisposeEditor(_editor);
        }

        if (_module is not null)
        {
            await DisposeModule(_module);
        }
    }

    private static async Task DisposeModule(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static async Task DisposeEditor(IJSObjectReference editor)
    {
        try
        {
            await editor.InvokeVoidAsync("dispose");
            await editor.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
